<?xml version="1.0" encoding="UTF-8"?>
<!-- coverage.py配置文件 -->
<coverage version="5.0" xmlns="https://nedbatchelder.com/coverage">
    <run>
        <!-- 源代码目录 -->
        <source>realtime_api</source>
        
        <!-- 分支覆盖率 -->
        <branch>true</branch>
        
        <!-- 并行执行 -->
        <parallel>true</parallel>
        
        <!-- 并发执行 -->
        <concurrency>thread, multiprocessing</concurrency>
        
        <!-- 忽略的文件和目录 -->
        <omit>
            */tests/*
            */__pycache__/*
            */.tox/*
            */.venv/*
            */venv/*
            *test_*.py
            *_test.py
            */migrations/*
            */docs/*
            setup.py
            __init__.py
        </omit>
        
        <!-- 相对路径 -->
        <relative_files>true</relative_files>
    </run>
    
    <!-- 报告配置 -->
    <report>
        <!-- 报告精度 -->
        <precision>2</precision>
        
        <!-- 显示缺失行 -->
        <show_missing>true</show_missing>
        
        <!-- 跳过已覆盖的文件 -->
        <skip_covered>true</skip_covered>
        
        <!-- 覆盖率阈值 -->
        <fail_under>80.0</fail_under>
        
        <!-- 排除的行 -->
        <exclude_lines>
            pragma: no cover
            def __repr__
            raise AssertionError
            raise NotImplementedError
            if __name__ == .__main__.:
            if TYPE_CHECKING:
            pass
            ...
            @abstractmethod
            @property
            @overload
        </exclude_lines>
    </report>
    
    <!-- HTML报告配置 -->
    <html>
        <directory>coverage_html</directory>
        <show_contexts>true</show_contexts>
        <title>智能电网负荷预测系统 - 测试覆盖率报告</title>
        <skip_covered>false</skip_covered>
        <skip_empty>true</skip_empty>
    </html>
    
    <!-- XML报告配置 -->
    <xml>
        <output>coverage.xml</output>
        <show_contexts>false</show_contexts>
    </xml>
    
    <!-- TSV报告配置 -->
    <tsv>
        <output>coverage.tsv</output>
    </tsv>
    
    <!-- JSON报告配置 -->
    <json>
        <output>coverage.json</output>
        <pretty_print>true</pretty_print>
        <show_contexts>true</show_contexts>
    </json>
</coverage>